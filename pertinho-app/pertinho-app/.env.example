# Copie para .env se usar um gerenciador de variáveis, ou defina no painel da hospedagem.
NODE_ENV=production
PORT=3000
DATA_DIR=/data
ADMIN_EMAIL=voce@seudominio.com
ADMIN_PASSWORD=troque-por-uma-senha-longa
TRUST_PROXY=1
PAYMENTS_MODE=off

# CPF: segredo que protege o resumo (HMAC) dos CPFs cadastrados. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Guarde em lugar seguro. Se trocar, CPFs já cadastrados deixam de ser reconhecidos como duplicados.
CPF_PEPPER=
# Pagamentos Pix via Asaas (PAYMENTS_MODE=asaas)
# ASAAS_API_KEY=
# ASAAS_WEBHOOK_TOKEN=um-token-longo-e-diferente-da-chave
# ASAAS_ENV=sandbox

# Endereço público do site (usado no link de convite). Sem isso usamos o endereço da requisição.
PUBLIC_URL=https://seudominio.com

# E-mail (Resend): recuperação de senha e confirmação de e-mail. Sem isso, a confirmação fica desligada e o ADM gera os links de senha.
# RESEND_API_KEY=
# MAIL_FROM=Pertinho <contato@seudominio.com>

# Prêmio da indicação só com selfie aprovada (padrão). Use 0 para liberar só com foto.
# REFERRAL_REQUIRE_VERIFIED=1

# Conferência do CPF na Receita (opcional; precisa contratar um provedor). Veja o README.
# CPF_LOOKUP_URL=https://api.provedor.com/cpf/{cpf}
# CPF_LOOKUP_TOKEN=
# CPF_LOOKUP_NAME_FIELD=nome
# CPF_LOOKUP_BIRTH_FIELD=nascimento
# CPF_LOOKUP_STATUS_FIELD=situacao
# CPF_LOOKUP_REQUIRED=1
