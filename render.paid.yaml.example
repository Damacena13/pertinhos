# Versão para usuários reais: plano pago com disco permanente. Renomeie para render.yaml quando for assinar.
services:
  - type: web
    name: pertinhos-oficial
    runtime: node
    plan: starter              # discos só existem em planos pagos (a partir de ~US$ 7/mês)
    region: ohio
    buildCommand: npm ci --include=dev && npm run build
    startCommand: npm start
    healthCheckPath: /healthz
    autoDeployTrigger: checksPass
    disk:
      name: pertinho-data
      mountPath: /data
      sizeGB: 1
    envVars:
      - key: NODE_VERSION
        value: 22.23.4
      - key: NODE_ENV
        value: production
      - key: DATA_DIR
        value: /data
      - key: TRUST_PROXY
        value: "1"
      - key: PAYMENTS_MODE
        value: "off"
      - key: ADMIN_EMAIL
        sync: false
      - key: ADMIN_PASSWORD
        sync: false
      - key: CPF_PEPPER
        sync: false
      - key: PUBLIC_URL
        sync: false
